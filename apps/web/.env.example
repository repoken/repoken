# Repoken web — environment
# Copy to .env.local and fill in.

# Privy (https://dashboard.privy.io) — GitHub OAuth login provider must be enabled.
NEXT_PUBLIC_PRIVY_APP_ID=

# QuickNode IPFS (https://dashboard.quicknode.com → IPFS) — used server-side to pin metadata JSON.
QUICKNODE_IPFS_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=https://your-gateway.quicknode-ipfs.com/ipfs/

# Deployed SplitterFactory address on Robinhood Chain (4663).
# Routes the 2% PONS launch tax → 1% Repoken treasury (buyback + burn) / 1% creator.
NEXT_PUBLIC_SPLITTER_FACTORY=

# Robinhood Chain RPC (public default provided; override for a private endpoint).
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# $REPOKEN contract address. Leave empty until launched (site shows "not live yet").
NEXT_PUBLIC_REPOKEN_CA=
