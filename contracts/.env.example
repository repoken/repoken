# Foundry environment for Robinhood Chain (4663).
# Copy to .env and fill in, then `source .env` before running forge scripts.

# RPC endpoint (referenced as `robinhood` in foundry.toml).
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<YOUR_KEY>

# Deployer key — DO NOT commit a real key. Use `--interactive` or a keystore
# in production instead of a plaintext value.
PRIVATE_KEY=

# Repoken treasury (receives 1% of the 2% launch tax, for buyback + burn).
TREASURY=
